{
  "name": "aurelia-living",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "db:up": "npm run infra:up",
    "db:down": "docker compose down",
    "db:status": "npm run db:status -w @aurelia-living/api",
    "db:deploy": "npm run db:deploy -w @aurelia-living/api",
    "db:seed": "npm run db:seed -w @aurelia-living/api",
    "db:studio": "npm run db:studio -w @aurelia-living/api",
    "db:reset": "npm run db:reset -w @aurelia-living/api",
    "build:types": "npm run build -w @aurelia-living/shared-types",
    "types:generate": "node scripts/generate-shared-types.mjs",
    "types:check": "node scripts/generate-shared-types.mjs --check",
    "typecheck": "turbo run typecheck",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "prepare": "husky || true",
    "docker:up": "docker compose up -d --no-recreate",
    "docker:down": "docker compose down",
    "infra:up": "docker compose up -d --no-recreate postgres redis minio minio-init mailpit",
    "infra:down": "docker compose stop postgres redis minio mailpit",
    "test:e2e:api": "npm run test:e2e -w @aurelia-living/api",
    "test:e2e:web": "npm run test:e2e -w @aurelia-living/web",
    "test:e2e:real": "node scripts/e2e-real.mjs",
    "test:e2e:db": "npm run test:e2e:db -w @aurelia-living/api",
    "mobile:build": "node scripts/mobile-build.mjs"
  },
  "devDependencies": {
    "turbo": "2.10.13",
    "typescript": "5.7.2",
    "eslint": "8.57.1",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "eslint-config-prettier": "9.1.2",
    "prettier": "3.9.9",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/three": "0.163.0"
  }
}
