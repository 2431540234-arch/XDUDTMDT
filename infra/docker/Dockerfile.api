# Image API (NestJS). Build từ thư mục gốc monorepo:  docker compose build api
FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl

# Chỉ copy file khai báo trước để tận dụng cache của npm ci
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN npm ci --ignore-scripts

COPY packages/shared-types packages/shared-types
COPY apps/api apps/api
RUN npm run build -w @aurelia-living/shared-types \
 && npx -w @aurelia-living/api prisma generate \
 && npm run build -w @aurelia-living/api

FROM node:22-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache openssl
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/api
EXPOSE 4000
# Áp migration (thử lại tối đa ~60s chờ DB sẵn sàng) rồi chạy API
CMD ["sh", "-c", "i=0; until npx prisma migrate deploy; do i=$((i+1)); [ $i -ge 20 ] && exit 1; sleep 3; done; node dist/main.js"]
