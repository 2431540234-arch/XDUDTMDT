# Dockerfile build cho app web (Next.js 14). Chạy từ GỐC repo:
#   docker build -f infra/docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com -t aurelia-web .
#
# QUAN TRỌNG: các biến NEXT_PUBLIC_* được Next.js NHÚNG VÀO MÃ lúc `next build` (không đọc lại khi chạy container), nên phải
# truyền bằng --build-arg; đặt chúng trong `env_file`/`environment` lúc chạy KHÔNG có tác dụng. Đổi giá trị ⇒ build lại.
#   NEXT_PUBLIC_API_URL                 BẮT BUỘC. Địa chỉ API mà TRÌNH DUYỆT gọi (vd https://api.example.com). Thiếu ⇒ build thất bại.
#   NEXT_PUBLIC_USE_MOCK                mặc định false. `true` bị CẤM khi build production (apps/web/next.config.js) ⇒ build thất bại.
#   NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED    mặc định false (đăng nhập Google chưa làm ở BE; nút ẩn).
FROM node:22-alpine AS build
WORKDIR /app

ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_USE_MOCK="false"
ARG NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED="false"
# Lỗi đã biết của Next trong npm workspaces ("Failed to patch lockfile … reading 'os'"): bỏ bước vá lockfile
ENV NEXT_IGNORE_INCORRECT_LOCKFILE=1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_USE_MOCK=${NEXT_PUBLIC_USE_MOCK} \
    NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=${NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED} \
    NEXT_TELEMETRY_DISABLED=1

# Thiếu địa chỉ API thì dừng NGAY với thông báo rõ ràng (thay vì build ra giao diện gọi nhầm địa chỉ)
RUN if [ -z "$NEXT_PUBLIC_API_URL" ]; then \
      echo "LỖI: thiếu --build-arg NEXT_PUBLIC_API_URL (ví dụ http://localhost:4000). Biến này được nhúng vào mã lúc build." >&2; \
      exit 1; \
    fi

# Cài thư viện theo lockfile (workspaces: cần package.json của MỌI workspace mới khớp package-lock.json)
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN npm ci --ignore-scripts

COPY packages/shared-types packages/shared-types
COPY apps/web apps/web

RUN npm run build -w @aurelia-living/shared-types \
 && npm run build -w @aurelia-living/web

ENV NODE_ENV=production
EXPOSE 3000
# Chạy `next start` (cổng 3000). Ảnh giữ cả devDependencies nên khá lớn; chưa dùng `output: 'standalone'`.
CMD ["npm", "run", "start", "-w", "@aurelia-living/web"]
