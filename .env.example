# Sao chép file này thành .env Ở THƯ MỤC GỐC (cp .env.example .env). Đây là file .env DUY NHẤT của cả monorepo:
# API (Nest), Prisma CLI, seed, test và web (Next) đều đọc file này. KHÔNG commit .env.
# Giá trị dưới đây chỉ dùng cho máy dev. Backend kiểm tra biến khi khởi động và dừng với thông báo rõ nếu thiếu/sai.

# ===== Cổng dịch vụ (thống nhất một bộ giá trị) =====
# API: 4000. Web: 3000. Nếu cổng bị chiếm, đổi cả PORT, API_PORT, NEXT_PUBLIC_API_URL, STORAGE_PUBLIC_URL.
PORT=4000
# Cổng API trên máy host khi chạy bằng docker compose (trong container API luôn nghe cổng 4000)
API_PORT=4000
# URL API mà trình duyệt gọi tới (web bắt buộc có biến này, thiếu là web không khởi động)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Các origin được phép gọi API (CORS), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# URL công khai của website (dùng đặt link trong email)
APP_URL=http://localhost:3000

# ===== Cơ sở dữ liệu =====
# Cổng PostgreSQL trên máy host (docker-compose đọc biến này). Đổi nếu 5432 đã bị chiếm; nhớ đổi cả cổng trong DATABASE_URL.
POSTGRES_PORT=5432
# Chuỗi kết nối khi chạy API/prisma NGOÀI docker (trên máy host). Trong docker, compose tự ghi đè.
DATABASE_URL="postgresql://aurelia:aurelia@localhost:5432/aurelia_dev?schema=public"
# Tên DB mà service postgres của compose tạo ở lần chạy đầu (volume mới). Container api tự dùng đúng DB này.
POSTGRES_DB=aurelia_dev
# (tùy chọn) Ghi đè chuỗi kết nối DB của container api. Mặc định: postgres:5432/$POSTGRES_DB
# DOCKER_DATABASE_URL=postgresql://aurelia:aurelia@postgres:5432/aurelia_dev?schema=public
# DB riêng cho test (docker compose --profile test up -d postgres-test). Test KHÔNG dùng DATABASE_URL ở trên.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL="postgresql://aurelia:aurelia@localhost:5433/aurelia_test?schema=public"

# ===== API khác =====
NODE_ENV=development
# Bật Swagger tại /docs (nên tắt ở production)
SWAGGER_ENABLED=true

# ===== Xác thực (BẮT BUỘC, tối thiểu 16 ký tự). Sinh ngẫu nhiên: openssl rand -hex 32 =====
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Redis (BullMQ hàng đợi + throttler) =====
REDIS_HOST=localhost
# Cổng Redis trên máy host. Đổi (ví dụ 6380) nếu 6379 đã bị Redis khác chiếm.
REDIS_PORT=6379

# ===== Lưu trữ tệp: local | minio | s3 (dev mặc định minio; production dùng s3, chỉ đổi biến, không đổi mã) =====
STORAGE_DRIVER=minio
# Chỉ dùng khi STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# URL công khai để client tải tệp từ bucket public.
#   minio: http://localhost:9000/aurelia-public   |   local: http://localhost:4000/uploads
STORAGE_PUBLIC_URL=http://localhost:9000/aurelia-public
# Thời hạn presigned URL (giây)
PRESIGN_EXPIRES_SECONDS=900

# ===== MinIO / S3 =====
# minio: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY bắt buộc.
# s3 (production): bỏ S3_ENDPOINT, đặt S3_REGION thật, S3_FORCE_PATH_STYLE=false; bỏ khóa truy cập nếu dùng IAM role.
S3_ENDPOINT=http://localhost:9000
# (tùy chọn) Endpoint mà TRÌNH DUYỆT gọi được, dùng ký presigned URL. Mặc định = S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# URL dạng /bucket/key (true, MinIO) hay bucket.s3.vùng.amazonaws.com (false, S3). Bỏ trống: true với minio, false với s3.
# S3_FORCE_PATH_STYLE=true
# Tài khoản MinIO dev (cũng là tài khoản đăng nhập Console). KHÔNG dùng ở production.
S3_ACCESS_KEY=aurelia
S3_SECRET_KEY=aurelia123
S3_BUCKET_PUBLIC=aurelia-public
S3_BUCKET_PRIVATE=aurelia-private
# Cổng MinIO trên máy host: API và Console (http://localhost:9001)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Giới hạn tốc độ (Redis). `default` áp dụng mọi route; `auth` chỉ áp dụng route gắn @AuthThrottle() (đăng nhập, đăng ký, quên mật khẩu) =====
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_SECONDS=60
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_SECONDS=60

# ===== Cache Redis (CacheService) =====
# false = tắt hẳn cache (get luôn miss, set/del không làm gì)
CACHE_ENABLED=true
CACHE_KEY_PREFIX=aurelia:cache:
CACHE_DEFAULT_TTL_SECONDS=300

# ===== Giới hạn tải lên (MB) =====
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_MODEL_MB=100
UPLOAD_MAX_PANORAMA_MB=20
# Ngưỡng kích thước (MB) cho mỗi tệp LOD mô hình 3D dùng cho web (NFR02). Job model-processing vượt ngưỡng thì đánh dấu
# `failed` và báo admin. Chỉ khai báo, logic kiểm tra làm ở M12.
MODEL_SERVE_MAX_MB=5

# ===== Email (dev dùng Mailpit; xem thư tại http://localhost:8025) =====
# queue: đẩy vào hàng đợi `mail` (retry 3 lần, backoff mũ), request không chờ SMTP | direct: gửi SMTP ngay trong request
MAIL_TRANSPORT=queue
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Aurelia Living <no-reply@aurelia.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ===== Thanh toán VNPay (sandbox). Để trống cho đến khi có tài khoản; chỉ cần khi làm module thanh toán =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=

# ===== Seed (npm run db:seed) =====
# false = chỉ seed dữ liệu bắt buộc (vai trò, quyền, settings, admin), bỏ dữ liệu mẫu
SEED_SAMPLE=true
SEED_ADMIN_EMAIL=admin@aurelia.vn
# Mật khẩu admin (dev). Production BẮT BUỘC tự đặt giá trị mạnh.
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SAMPLE_USER_PASSWORD=User@123456

# ===== NGOÀI PHẠM VI đồ án (không dùng) =====
# AI (OpenAI/Ollama): xem docs/DECISIONS.md.

# ===== Chỉ cho test e2e (tùy chọn; có mặc định) =====
# API của Mailpit để test kiểm tra email đã tới
# MAILPIT_API_URL=http://localhost:8025
