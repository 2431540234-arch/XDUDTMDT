# Sao chép file này thành .env (cp .env.example .env) rồi chỉnh. KHÔNG commit .env.
# Giá trị dưới đây chỉ dùng cho máy dev. Backend kiểm tra biến khi khởi động và dừng với thông báo rõ nếu thiếu/sai.

# ===== Cơ sở dữ liệu =====
# Cổng PostgreSQL trên máy host (docker-compose đọc biến này). Đổi nếu 5432 đã bị chiếm; nhớ đổi cả cổng trong DATABASE_URL.
POSTGRES_PORT=5432
# Chuỗi kết nối khi chạy API/prisma NGOÀI docker (trên máy host). Trong docker, compose tự ghi đè.
DATABASE_URL="postgresql://aurelia:aurelia@localhost:5432/aurelia_living?schema=public"
# DB riêng cho test (docker compose --profile test up -d postgres-test). Test KHÔNG dùng DATABASE_URL ở trên.
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL="postgresql://aurelia:aurelia@localhost:5433/aurelia_test?schema=public"

# ===== API =====
NODE_ENV=development
PORT=4000
# Cổng API trên máy host khi chạy bằng docker compose (đổi nếu 4000 bị chiếm)
API_PORT=4000
# Các origin được phép gọi API (CORS), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
# URL công khai của website (dùng đặt link trong email)
APP_URL=http://localhost:3000
# Bật Swagger tại /docs (nên tắt ở production)
SWAGGER_ENABLED=true

# ===== Xác thực (BẮT BUỘC, tối thiểu 16 ký tự). Sinh ngẫu nhiên: openssl rand -hex 32 =====
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Lưu trữ tệp =====
# local = ghi vào thư mục trên đĩa. Sau này thêm: minio
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# URL công khai để client tải tệp
STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# ===== Email (dev dùng Mailpit; xem thư tại http://localhost:8025) =====
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Aurelia Living <no-reply@aurelia.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ===== Seed (npm run db:seed) =====
# false = chỉ seed dữ liệu bắt buộc (vai trò, quyền, settings, admin), bỏ dữ liệu mẫu
SEED_SAMPLE=true
SEED_ADMIN_EMAIL=admin@aurelia.vn
# Mật khẩu admin (dev). Production BẮT BUỘC tự đặt giá trị mạnh.
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SAMPLE_USER_PASSWORD=User@123456

# ===== Web (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== Chưa dùng ở giai đoạn nền tảng (giữ sẵn cho sau) =====
# REDIS_HOST=localhost
# REDIS_PORT=6379
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=aurelia-living
# S3_ACCESS_KEY=aurelia
# S3_SECRET_KEY=aurelia123
# AI_PROVIDER=ollama
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ===== Docker compose =====
# (tùy chọn) Chuỗi kết nối DB mà container api dùng. Mặc định: DB aurelia_living trong service postgres của compose.
# DOCKER_DATABASE_URL=postgresql://aurelia:aurelia@postgres:5432/aurelia_living?schema=public
