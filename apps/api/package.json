{
  "name": "@aurelia-living/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @aurelia-living/shared-types && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config ./jest.config.js",
    "test:e2e": "jest --config ./test/jest-e2e.config.js --runInBand --forceExit",
    "test:e2e:db": "jest --config ./test/jest-db.config.js --runInBand --forceExit",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:process-models": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed-models-cli.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "echo \"Đã vô hiệu hóa: dùng node scripts/db-reset.mjs aurelia_demo|aurelia_test (không bao giờ reset aurelia_dev)\" && exit 1",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@aurelia-living/shared-types": "*",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@bull-board/api": "9.10.4",
    "@bull-board/express": "9.10.4",
    "@bull-board/nestjs": "9.10.4",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "draco3dgltf": "1.5.7",
    "helmet": "7.2.0",
    "ioredis": "5.11.1",
    "meshoptimizer": "0.18.1",
    "nodemailer": "6.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "20.19.43",
    "@types/nodemailer": "6.4.24",
    "@types/supertest": "6.0.3",
    "dotenv": "16.4.5",
    "dotenv-cli": "11.0.0",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
