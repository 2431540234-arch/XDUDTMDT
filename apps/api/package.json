{
  "name": "@aurelia-living/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build -w @aurelia-living/shared-types && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config ./jest.config.js",
    "test:e2e": "jest --config ./test/jest-e2e.config.js --runInBand --forceExit",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@aurelia-living/shared-types": "*",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@bull-board/nestjs": "^9.10.4",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^10.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "draco3dgltf": "^1.5.7",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "meshoptimizer": "^0.18.1",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
