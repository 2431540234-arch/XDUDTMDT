// =====================================================================
// PRISMA SCHEMA — ánh xạ Prisma Client sang DB thật được định nghĩa tại
// prisma/schema.sql (đây là NGUỒN CHUẨN / source of truth cho cấu trúc DB).
//
// QUAN TRỌNG — những phần CHỈ tồn tại trong schema.sql, Prisma Schema
// Language (PSL) không có cách biểu diễn, nên KHÔNG xuất hiện ở file này:
//   - Trigger & hàm PL/pgSQL (set_updated_at, refresh_product_rating,
//     refresh_product_3d_flags_for, refresh_space_view_count...)
//   - CHECK constraint (range số, công thức tiền, ràng buộc nhiều cột...)
//   - Partial unique index (vd: UNIQUE ... WHERE is_primary / is_default)
//     -> chỉ ghi chú bằng comment tại model liên quan, KHÔNG khai báo
//     @@index/@@unique thay thế để tránh tạo sai ràng buộc.
//   - Index biểu thức (f_unaccent(lower(name)) cho tìm kiếm tiếng Việt)
//   - Generated column (order_items.line_total)
//
// ⚠ CHỈ dùng `prisma migrate dev` / `prisma migrate deploy` cho project này.
//   KHÔNG dùng `prisma db push` — lệnh đó đồng bộ DB khớp y nguyên schema
//   này và sẽ XÓA mất toàn bộ phần chỉ có trong schema.sql ở trên.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, unaccent]
}

// ---------------------------------------------------------------------
// ENUM (ánh xạ 1:1 tới các CREATE TYPE ... AS ENUM trong schema.sql)
// ---------------------------------------------------------------------
enum UserStatus {
  active
  inactive
  banned

  @@map("user_status")
}

enum PublishStatus {
  draft
  published
  archived

  @@map("publish_status")
}

enum CommentStatus {
  pending
  approved
  spam

  @@map("comment_status")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipping
  completed
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum PaymentMethod {
  cod
  bank_transfer
  momo
  vnpay
  zalopay
  card

  @@map("payment_method")
}

enum ShipmentStatus {
  pending
  picked_up
  in_transit
  delivered
  returned

  @@map("shipment_status")
}

enum DiscountType {
  percent
  fixed

  @@map("discount_type")
}

enum ModelFormat {
  glb
  gltf
  usdz
  reality
  fbx
  obj

  @@map("model_format")
}

enum ModelLod {
  high
  medium
  low

  @@map("model_lod")
}

enum ModelStatus {
  uploading
  processing
  ready
  failed

  @@map("model_status")
}

enum ArPlacement {
  floor
  wall
  table
  any

  @@map("ar_placement")
}

enum ArPlatform {
  webxr
  scene_viewer
  quick_look
  arcore
  arkit

  @@map("ar_platform")
}

enum SpaceRoomType {
  living_room
  bedroom
  kitchen
  dining_room
  office
  kids_room
  outdoor
  other

  @@map("space_room_type")
}

enum SpaceHotspotType {
  product
  navigation
  info

  @@map("space_hotspot_type")
}

// =====================================================================
// 1. NGƯỜI DÙNG & PHÂN QUYỀN
// =====================================================================
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String     @map("full_name") @db.VarChar(150)
  email           String     @unique @db.Citext
  phone           String?    @unique @db.VarChar(20)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  roles              UserRole[]
  passwordResets     PasswordReset[]
  sessions           UserSession[]
  addresses          Address[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  uploadedMedia      Media[]
  createdModels      Product3dModel[]
  arSessions         ArSession[]
  arSnapshots        ArSnapshot[]
  inventoryMovements InventoryMovement[]
  reviews            Review[]
  wishlists          Wishlist[]
  cart               Cart?
  orders             Order[]
  orderStatusChanges OrderStatusHistory[]
  couponUsages       CouponUsage[]
  createdSpaces      Space[]
  spaceBookmarks     SpaceBookmark[]
  spaceViews         SpaceView[]

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(100)
  name String @db.VarChar(150)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_resets")
}

model UserSession {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  refreshToken String               @unique @map("refresh_token") @db.VarChar(255)
  ipAddress    Unsupported("inet")? @map("ip_address")
  userAgent    String?              @map("user_agent")
  expiresAt    DateTime             @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_sessions")
}

model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(150)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(100)
  district      String?  @db.VarChar(100)
  ward          String?  @db.VarChar(100)
  street        String   @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // NOTE: uq_addresses_default = UNIQUE INDEX ... WHERE is_default (partial) — chỉ ở schema.sql.
  @@map("addresses")
}

// =====================================================================
// 2. HỆ THỐNG CHUNG
// =====================================================================
model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model Media {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  path       String
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt   @map("size_bytes")
  altText    String?  @map("alt_text") @db.VarChar(255)
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  categories        Category[]
  brands            Brand[]
  productImages     ProductImage[]
  modelPosters      Product3dModel[] @relation("ModelPosterMedia")
  modelEnvironments Product3dModel[] @relation("ModelEnvironmentImage")
  modelFiles        ModelFile[]
  arSnapshots       ArSnapshot[]
  spaces            Space[]
  spacePanoramas    SpacePanorama[]

  @@map("media")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(255)
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // NOTE: idx_notifications_unread = INDEX ... WHERE read_at IS NULL (partial) — chỉ ở schema.sql.
  @@map("notifications")
}

model ActivityLog {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?              @map("user_id") @db.Uuid
  action     String               @db.VarChar(100)
  targetType String?              @map("target_type") @db.VarChar(50)
  targetId   String?              @map("target_id") @db.Uuid
  changes    Json?
  ipAddress  Unsupported("inet")? @map("ip_address")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([targetType, targetId], map: "idx_activity_target")
  @@map("activity_logs")
}

// =====================================================================
// 3. NỘI DUNG: DANH MỤC, TRANG TĨNH
// =====================================================================
model Category {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  type            String   @default("product") @db.VarChar(20) // CHECK: 'product' | 'space' (schema.sql)
  name            String   @db.VarChar(150)
  slug            String   @db.VarChar(180)
  description     String?
  imageId         String?  @map("image_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children Category[] @relation("CategoryParent")
  image    Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  products Product[]
  spaces   Space[]

  @@unique([type, slug])
  @@index([parentId], map: "idx_categories_parent")
  @@map("categories")
}

model Page {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(280)
  content         String
  status          PublishStatus @default(draft)
  metaTitle       String?       @map("meta_title") @db.VarChar(255)
  metaDescription String?       @map("meta_description") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("pages")
}

// =====================================================================
// 4. SẢN PHẨM
// =====================================================================
model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(180)
  logoId    String?  @map("logo_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  logo     Media?    @relation(fields: [logoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products Product[]

  @@map("brands")
}

model Product {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String?       @map("category_id") @db.Uuid
  brandId          String?       @map("brand_id") @db.Uuid
  name             String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(280)
  shortDescription String?       @map("short_description")
  description      String?
  status           PublishStatus @default(draft)
  isFeatured       Boolean       @default(false) @map("is_featured")
  has3d            Boolean       @default(false) @map("has_3d")
  arEnabled        Boolean       @default(false) @map("ar_enabled")
  ratingAvg        Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int           @default(0) @map("rating_count")
  soldCount        Int           @default(0) @map("sold_count")
  metaTitle        String?       @map("meta_title") @db.VarChar(255)
  metaDescription  String?       @map("meta_description") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  variants           ProductVariant[]
  images             ProductImage[]
  models3d           Product3dModel[]
  arSessions         ArSession[]
  arSnapshots        ArSnapshot[]
  reviews            Review[]
  wishlists          Wishlist[]
  spaceHotspots      SpaceHotspot[]
  spacePlacements    SpaceProductPlacement[]
  spaceViewReferrals SpaceView[]

  // NOTE: idx_products_category có WHERE deleted_at IS NULL (partial);
  // idx_products_name_trgm là expression index (f_unaccent + trgm). Cả hai chỉ ở schema.sql.
  @@index([brandId], map: "idx_products_brand")
  @@map("products")
}

model Attribute {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(100)

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String @db.VarChar(100)

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variants  VariantAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductVariant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  sku           String   @unique @db.VarChar(100)
  price         Decimal  @db.Decimal(14, 2)
  salePrice     Decimal? @map("sale_price") @db.Decimal(14, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  weightGrams   Int?     @map("weight_grams")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  attributeValues    VariantAttributeValue[]
  images             ProductImage[]
  models3d           Product3dModel[]
  materialVariants   ModelMaterialVariant[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  spacePlacements    SpaceProductPlacement[]

  // NOTE: CHECK (sale_price IS NULL OR sale_price <= price) — chỉ ở schema.sql.
  @@index([productId], map: "idx_variants_product")
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // NOTE: uq_product_primary_image = UNIQUE INDEX ... WHERE is_primary (partial) — chỉ ở schema.sql.
  @@map("product_images")
}

// =====================================================================
// 4b. MÔ HÌNH 3D & AR
// =====================================================================
model Product3dModel {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String      @map("product_id") @db.Uuid
  variantId          String?     @map("variant_id") @db.Uuid
  name               String      @db.VarChar(255)
  status             ModelStatus @default(uploading)
  version            Int         @default(1)
  isPrimary          Boolean     @default(false) @map("is_primary")
  realWidthMm        Decimal     @map("real_width_mm") @db.Decimal(10, 2)
  realHeightMm       Decimal     @map("real_height_mm") @db.Decimal(10, 2)
  realDepthMm        Decimal     @map("real_depth_mm") @db.Decimal(10, 2)
  arEnabled          Boolean     @default(true) @map("ar_enabled")
  arPlacement        ArPlacement @default(floor) @map("ar_placement")
  arAllowScaling     Boolean     @default(false) @map("ar_allow_scaling")
  posterMediaId      String?     @map("poster_media_id") @db.Uuid
  cameraOrbit        String?     @map("camera_orbit") @db.VarChar(100)
  autoRotate         Boolean     @default(true) @map("auto_rotate")
  environmentImageId String?     @map("environment_image_id") @db.Uuid
  exposure           Decimal     @default(1.0) @db.Decimal(4, 2)
  processingError    String?     @map("processing_error")
  createdBy          String?     @map("created_by") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posterMedia      Media?          @relation("ModelPosterMedia", fields: [posterMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  environmentImage Media?          @relation("ModelEnvironmentImage", fields: [environmentImageId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  creator          User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  files                  ModelFile[]
  materialVariants       ModelMaterialVariant[]
  arSessions             ArSession[]
  spaceProductPlacements SpaceProductPlacement[]

  // NOTE: uq_3d_models_primary = UNIQUE INDEX ... WHERE is_primary (partial) — chỉ ở schema.sql.
  @@index([productId], map: "idx_3d_models_product")
  @@map("product_3d_models")
}

model ModelFile {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId             String      @map("model_id") @db.Uuid
  mediaId             String      @map("media_id") @db.Uuid
  format              ModelFormat
  lod                 ModelLod    @default(high)
  polygonCount        Int?        @map("polygon_count")
  textureResolution   Int?        @map("texture_resolution")
  isDracoCompressed   Boolean     @default(false) @map("is_draco_compressed")
  checksumSha256      String?     @map("checksum_sha256") @db.Char(64)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  model Product3dModel @relation(fields: [modelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([modelId, format, lod])
  @@map("model_files")
}

model ModelMaterialVariant {
  modelId      String @map("model_id") @db.Uuid
  variantId    String @map("variant_id") @db.Uuid
  materialName String @map("material_name") @db.VarChar(100)

  model   Product3dModel @relation(fields: [modelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([modelId, variantId])
  @@map("model_material_variants")
}

model ArSession {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modelId         String      @map("model_id") @db.Uuid
  productId       String      @map("product_id") @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  sessionKey      String?     @map("session_key") @db.VarChar(100)
  mode            String      @db.VarChar(10) // CHECK: '3d' | 'ar' (schema.sql)
  platform        ArPlatform?
  deviceOs        String?     @map("device_os") @db.VarChar(30)
  deviceModel     String?     @map("device_model") @db.VarChar(100)
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  durationSeconds Int?        @map("duration_seconds")
  objectPlaced    Boolean     @default(false) @map("object_placed")
  snapshotTaken   Boolean     @default(false) @map("snapshot_taken")
  addedToCart     Boolean     @default(false) @map("added_to_cart")

  model     Product3dModel @relation(fields: [modelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  snapshots ArSnapshot[]

  // NOTE: CHECK (mode = '3d' OR platform IS NOT NULL) — chỉ ở schema.sql.
  @@index([productId, startedAt(sort: Desc)], map: "idx_ar_sessions_product")
  @@map("ar_sessions")
}

model ArSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arSessionId String?  @map("ar_session_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  mediaId     String   @map("media_id") @db.Uuid
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  arSession ArSession? @relation(fields: [arSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media     Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ar_snapshots")
}

model InventoryMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  changeQty   Int      @map("change_qty")
  reason      String   @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.Uuid
  note        String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([variantId, createdAt(sort: Desc)], map: "idx_inventory_variant")
  @@map("inventory_movements")
}

model Review {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  orderItemId String?       @map("order_item_id") @db.Uuid
  rating      Int           @db.SmallInt
  content     String?
  status      CommentStatus @default(pending)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_reviews_order_item")

  @@unique([productId, userId, orderItemId])
  @@map("reviews")
}

model Wishlist {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, productId])
  @@map("wishlists")
}

// =====================================================================
// 5. GIỎ HÀNG, KHUYẾN MÃI, ĐƠN HÀNG
// =====================================================================
model Cart {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  sessionId String?  @unique @map("session_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items CartItem[]

  // NOTE: CHECK (user_id IS NOT NULL OR session_id IS NOT NULL) — chỉ ở schema.sql.
  @@map("carts")
}

model CartItem {
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String       @unique @db.VarChar(50)
  description    String?
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(14, 2)
  maxDiscount    Decimal?     @map("max_discount") @db.Decimal(14, 2)
  minOrderAmount Decimal      @default(0) @map("min_order_amount") @db.Decimal(14, 2)
  usageLimit     Int?         @map("usage_limit")
  perUserLimit   Int          @default(1) @map("per_user_limit")
  usedCount      Int          @default(0) @map("used_count")
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(6)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  orders Order[]
  usages CouponUsage[]

  // NOTE: CHECK (ends_at > starts_at); CHECK (discount_type <> 'percent' OR discount_value <= 100) — chỉ ở schema.sql.
  @@map("coupons")
}

model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderCode       String        @unique @map("order_code") @db.VarChar(30)
  userId          String?       @map("user_id") @db.Uuid
  couponId        String?       @map("coupon_id") @db.Uuid
  status          OrderStatus   @default(pending)
  recipientName   String        @map("recipient_name") @db.VarChar(150)
  recipientPhone  String        @map("recipient_phone") @db.VarChar(20)
  recipientEmail  String?       @map("recipient_email") @db.Citext
  shippingAddress String        @map("shipping_address")
  subtotal        Decimal       @db.Decimal(14, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(14, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  note            String?
  cancelledReason String?       @map("cancelled_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  items         OrderItem[]
  couponUsage   CouponUsage?
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]

  // NOTE: CHECK (total_amount = subtotal - discount_amount + shipping_fee) — chỉ ở schema.sql.
  @@index([userId, createdAt(sort: Desc)], map: "idx_orders_user")
  @@index([status, createdAt(sort: Desc)], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(255)
  variantName String? @map("variant_name") @db.VarChar(255)
  sku         String  @db.VarChar(100)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  quantity    Int
  // Generated column: GENERATED ALWAYS AS (unit_price * quantity) STORED (schema.sql).
  // KHÔNG set giá trị này từ app — Postgres tự tính, Prisma chỉ đọc lại.
  // Prisma không hỗ trợ generated column: `prisma migrate diff`/`db pull` sẽ luôn đề
  // xuất 1 dòng ALTER vô hại (DROP DEFAULT) cho cột này — KHÔNG áp dụng dòng đó.
  lineTotal   Decimal? @map("line_total") @db.Decimal(14, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviews Review[]

  @@index([orderId], map: "idx_order_items_order")
  @@map("order_items")
}

model CouponUsage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String?  @map("user_id") @db.Uuid
  orderId  String   @unique @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("coupon_usages")
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?
  changedBy  String?      @map("changed_by") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changer User? @relation(fields: [changedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  method          PaymentMethod
  amount          Decimal       @db.Decimal(14, 2)
  status          PaymentStatus @default(pending)
  transactionId   String?       @unique @map("transaction_id") @db.VarChar(150)
  gatewayResponse Json?         @map("gateway_response")
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_payments_order")
  @@map("payments")
}

model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  carrier        String         @db.VarChar(50)
  trackingNumber String?        @unique @map("tracking_number") @db.VarChar(100)
  status         ShipmentStatus @default(pending)
  fee            Decimal        @default(0) @db.Decimal(14, 2)
  shippedAt      DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("shipments")
}

// =====================================================================
// 6. KHÔNG GIAN MẪU (SPACES) & PANORAMA 360°
// =====================================================================
model Space {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String?       @map("category_id") @db.Uuid
  name            String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(280)
  description     String?
  roomType        SpaceRoomType @default(other) @map("room_type")
  style           String?       @db.VarChar(100)
  coverMediaId    String?       @map("cover_media_id") @db.Uuid
  status          PublishStatus @default(draft)
  isFeatured      Boolean       @default(false) @map("is_featured")
  viewCount       Int           @default(0) @map("view_count")
  metaTitle       String?       @map("meta_title") @db.VarChar(255)
  metaDescription String?       @map("meta_description") @db.VarChar(500)
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  coverMedia Media?    @relation(fields: [coverMediaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  creator    User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  panoramas SpacePanorama[]
  bookmarks SpaceBookmark[]
  views     SpaceView[]

  // view_count tự tăng bằng trigger trg_space_views_count khi có SpaceView mới (schema.sql).
  // idx_spaces_name_trgm là expression index (f_unaccent + trgm) — chỉ ở schema.sql.
  @@index([roomType], map: "idx_spaces_room_type")
  @@index([status], map: "idx_spaces_status")
  @@map("spaces")
}

model SpacePanorama {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId      String   @map("space_id") @db.Uuid
  mediaId      String   @map("media_id") @db.Uuid
  title        String?  @db.VarChar(150)
  initialYaw   Decimal  @default(0) @map("initial_yaw") @db.Decimal(6, 2)
  initialPitch Decimal  @default(0) @map("initial_pitch") @db.Decimal(6, 2)
  initialFov   Decimal  @default(75) @map("initial_fov") @db.Decimal(5, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  hotspots          SpaceHotspot[]          @relation("HotspotPanorama")
  navigationTargets SpaceHotspot[]          @relation("HotspotTargetPanorama")
  placements        SpaceProductPlacement[]
  views             SpaceView[]

  // NOTE: uq_space_panoramas_default = UNIQUE INDEX ... WHERE is_default (partial) — chỉ ở schema.sql.
  @@index([spaceId], map: "idx_space_panoramas_space")
  @@map("space_panoramas")
}

model SpaceHotspot {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panoramaId       String           @map("panorama_id") @db.Uuid
  type             SpaceHotspotType
  yaw              Decimal          @db.Decimal(6, 2)
  pitch            Decimal          @db.Decimal(6, 2)
  productId        String?          @map("product_id") @db.Uuid
  targetPanoramaId String?          @map("target_panorama_id") @db.Uuid
  label            String?          @db.VarChar(255)
  icon             String?          @db.VarChar(50)
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  panorama       SpacePanorama  @relation("HotspotPanorama", fields: [panoramaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetPanorama SpacePanorama? @relation("HotspotTargetPanorama", fields: [targetPanoramaId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  // NOTE: CHECK đảm bảo đúng cột đi kèm theo từng loại `type` — chỉ ở schema.sql.
  // idx_space_hotspots_product có WHERE product_id IS NOT NULL (partial) — chỉ ở schema.sql.
  @@index([panoramaId], map: "idx_space_hotspots_panorama")
  @@map("space_hotspots")
}

model SpaceProductPlacement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  panoramaId    String   @map("panorama_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  modelId       String?  @map("model_id") @db.Uuid
  positionYaw   Decimal  @map("position_yaw") @db.Decimal(6, 2)
  positionPitch Decimal  @map("position_pitch") @db.Decimal(6, 2)
  distanceM     Decimal  @default(2.0) @map("distance_m") @db.Decimal(6, 2)
  rotationY     Decimal  @default(0) @map("rotation_y") @db.Decimal(6, 2)
  scale         Decimal  @default(1.0) @db.Decimal(5, 2)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  panorama SpacePanorama   @relation(fields: [panoramaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  model    Product3dModel? @relation(fields: [modelId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([panoramaId], map: "idx_space_placements_panorama")
  @@index([productId], map: "idx_space_placements_product")
  @@map("space_product_placements")
}

model SpaceBookmark {
  userId    String   @map("user_id") @db.Uuid
  spaceId   String   @map("space_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, spaceId])
  @@map("space_bookmarks")
}

model SpaceView {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId           String   @map("space_id") @db.Uuid
  panoramaId        String?  @map("panorama_id") @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  sessionKey        String?  @map("session_key") @db.VarChar(100)
  referrerProductId String?  @map("referrer_product_id") @db.Uuid
  startedAt         DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  durationSeconds   Int?     @map("duration_seconds")
  hotspotClicks     Int      @default(0) @map("hotspot_clicks")
  addedToCart       Boolean  @default(false) @map("added_to_cart")

  space           Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  panorama        SpacePanorama? @relation(fields: [panoramaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referrerProduct Product?       @relation(fields: [referrerProductId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([spaceId, startedAt(sort: Desc)], map: "idx_space_views_space")
  @@map("space_views")
}
