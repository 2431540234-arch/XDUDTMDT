// =====================================================================
// PRISMA SCHEMA – Aurelia Living (PostgreSQL 15+)
// Sinh từ `prisma db pull` rồi chỉnh tên cho dễ dùng; nguồn chuẩn cấu trúc DB là
// các migration trong prisma/migrations (baseline 0_init). Xem docs/DATABASE_SCHEMA.md.
//
// CHỈ dùng `prisma migrate dev` / `prisma migrate deploy`. KHÔNG dùng `prisma db push`.
//
// Những thứ chỉ tồn tại trong DB (migration SQL), Prisma không biểu diễn được:
//   - CHECK constraint (tiền >= 0, total = subtotal - discount + shipping, hotspot theo loại...)
//   - Partial unique index (email chưa xóa mềm, địa chỉ mặc định, ảnh đại diện, mô hình chính, ảnh mở đầu)
//   - Index biểu thức / GIN trigram (spaces.title không dấu, products.name)
//   - Generated column (order_items.line_total)
//   - UNIQUE NULLS NOT DISTINCT (reviews), khóa ngoại SET NULL (cột) (space_product_placements.variant_id)
//   - Hàm và trigger PL/pgSQL (updated_at, rating, has_3d_model/has_ar, view_count, order_status_history, vai trò mặc định)
// => Khi `migrate dev` sinh migration mới, LUÔN đọc lại SQL; với CHECK/trigger dùng `--create-only` rồi sửa file.
//
// Quy ước: model PascalCase số ít (@@map về tên bảng), field camelCase (@map về tên cột),
// quan hệ đặt tên theo khóa ngoại (user, product, variant...); cặp model có nhiều quan hệ
// được đặt tên tường minh (ví dụ "SpaceHotspotPanorama").
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, pgcrypto, unaccent]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ActivityLog {
  id         Int      @id(map: "pk_activity_logs") @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   Int?     @map("target_id")
  changes    Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onUpdate: NoAction, map: "fk_activity_logs_actor_id")

  @@index([actorId], map: "idx_activity_logs_actor_id")
  @@index([createdAt(sort: Desc)], map: "idx_activity_logs_created")
  @@index([targetType, targetId], map: "idx_activity_logs_target")
  @@map("activity_logs")
}

