    }
    class Media {
        +Int id «PK»
        +String fileName
        +String filePath «UK»
        +String mimeType
        +Int fileSize
        +String? altText
        +Int? uploadedBy «FK»
        +DateTime createdAt
        +DateTime updatedAt
        +getUrl() String
    }
    class Notification {
        +Int id «PK»
        +Int userId «FK»
        +String title
        +Json data
        +DateTime? readAt
        +DateTime createdAt
        +markRead()
    }
    class ActivityLog {
        +Int id «PK»
        +Int? actorId «FK»
        +String action
        +String? targetType
        +Int? targetId
        +Json? changes
        +String? ipAddress
        +DateTime createdAt
        +record(adminId, action, target)
    }
