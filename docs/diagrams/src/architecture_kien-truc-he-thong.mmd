        GW["Cổng thanh toán"]
        SH["Đơn vị vận chuyển"]
        SMTP["Dịch vụ email"]
    end
    WEB -- "HTTPS /api" --> GUARD --> CTRL --> SVC --> PRISMA --> PG
    SVC -- "đưa job" --> RD
    RD --> JOBS
    JOBS --> S3
